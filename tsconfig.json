{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  /*
   * הבנייה של האפליקציה (`npm run build` = `tsc && vite build`) בודקת רק קוד
   * שהאפליקציה עצמה מריצה. `tests/rules` ו-`tests/mirrors` מייבאים מ-`functions/`,
   * שהתלויות שלו (`firebase-admin`) מותקנות רק ב-`functions/node_modules` - ולא
   * ב-job של הפריסה. הם נבדקים ב-`tsconfig.tests.json` (`npm run typecheck:tests`).
   */
  "include": ["src", "tests/hosting"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
