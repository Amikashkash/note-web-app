rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // קריאת מערך השיתוף בצורה בטוחה.
    // מסמכים שנוצרו לפני שהשדה נוסף לא מכילים אותו, וגישה ישירה
    // אליהם הייתה מכשילה את כל הביטוי ולא רק את התנאי הזה.
    function sharedUsers(data) {
      return data.get('sharedWith', []);
    }

    function isSharedWithMe(data) {
      return isAuthenticated() && request.auth.uid in sharedUsers(data);
    }

    // האם העדכון משאיר את שדות הבעלות ללא שינוי.
    // משתמש ששותפו איתו רשאי לערוך תוכן בלבד - לא להשתלט על הפריט
    // ולא לשנות עם מי הוא משותף.
    function ownershipUnchanged() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.get('sharedWith', []) == sharedUsers(resource.data);
    }

    // שדות שרק הבעלים משנה, גם כששאר העדכון מותר לשותף.
    // `diff` מתייחס גם להוספת שדה שלא היה, כך ששותף לא יכול "ליצור" אותו.
    function ownerOnlyFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // נמען שמסיר את עצמו משיתוף (SH-1). העדכון היחיד המותר: להוריד את
    // עצמו מ-`sharedWith` - לא אחרים, לא להוסיף, ולא לגעת בשום שדה אחר
    // חוץ מחותמת הכותב (כולל `clientVersion`, D4a). בלי זה לנמען לא הייתה
    // דרך להיפטר מפתק ששותף איתו.
    function isLeavingShare() {
      return isSharedWithMe(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['sharedWith', 'updatedAt', 'updatedBy', 'clientVersion'])
        && request.resource.data.get('sharedWith', []).toSet()
          == sharedUsers(resource.data).toSet().difference([request.auth.uid].toSet());
    }

    match /categories/{categoryId} {
      allow read: if isOwner(resource.data.userId) || isSharedWithMe(resource.data);

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // `isSensitive` (§12 בסקירה): רק הבעלים מסמן או מבטל. אחרת שותף
      // יכול היה לחשוף ל-Claude של כולם קטגוריה שהבעלים הסתיר.
      // `isReadOnly` (קריאה בלבד ל-Claude) - אותו כלל.
      allow update: if isOwner(resource.data.userId)
        || (isSharedWithMe(resource.data) && ownershipUnchanged()
          && ownerOnlyFieldsUnchanged(['isSensitive', 'isReadOnly']))
        || isLeavingShare();

      allow delete: if isOwner(resource.data.userId);
    }

    function canReadNote(data) {
      return isOwner(data.userId) || isSharedWithMe(data);
    }

    match /notes/{noteId} {
      allow read: if canReadNote(resource.data);

      // `updatedBy` - מי כתב אחרון. היסטוריית הגרסאות מייחסת שינויים לפיו.
      //
      // שלב 2 (B6b, סבב 1 בשיפורים - כל האפליקציה כותבת אותו מאז v1.21.0):
      // חובה בכל כתיבה, ותמיד המשתמש המחובר. כך אי אפשר לרשום שינוי בשם של
      // מישהו אחר, ולקוח ישן מלפני השדה לא יכול לכתוב מעל כותב אחר.
      //
      // rules רואים רק את התוצאה: כתיבה שלא שולחת את השדה לפתק שהכותב
      // עצמו כתב בו אחרון נראית זהה לכתיבה ששולחת אותו, ועוברת. זה לא מזיק -
      // הייחוס ממילא שלו. (שלב 1 התיר להשמיט את השדה בכל מקרה.)
      // השרת (MCP, הטריגר) כותב דרך Admin SDK ועוקף את הכללים האלה.
      function writerStamp() {
        return request.resource.data.get('updatedBy', null) == request.auth.uid;
      }

      // `createdVia` ("נוצר ע"י Claude") נכתב רק ע"י השרת (Admin SDK).
      // האפליקציה לא יוצרת אותו, לא משנה ולא מוחקת - כך הסימון אמין.
      function createdViaUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdVia']);
      }

      // `revision` (C-1). כתיבה שקובעת אותו חייבת לקבוע בדיוק `הקודם + 1`
      // (בשלב 1, עד סבב 1 בשיפורים, כתיבה שלא נגעה בו עברה תמיד - גם של
      // תוכן). העורך הפתוח שולח `בסיס + 1` מפורש, ולכן
      // אם מישהו אחר כתב בינתיים - הכתיבה נדחית (גם כשהמתינה offline)
      // במקום לדרוס. `increment(1)` תמיד עובר: ה-rule רואה את התוצאה.
      // מסמך ישן בלי השדה = 0.
      //
      // `saveId` (מזהה אקראי לכל שמירה של העורך): בלעדיו, שמירה ישנה ששולחת
      // `revision` ששווה במקרה לערך הנוכחי (בסיס 3 → 4, כשבשרת כבר 4) לא
      // "משנה" את השדה, ונראית כמו לקוח ישן. `saveId` תמיד משתנה, ולכן
      // שמירה של העורך תמיד נבדקת.
      //
      // שלב 2 (סבב 1 בשיפורים - האפליקציה שולחת אותו מאז v1.26.0): כתיבה
      // שמשנה **תוכן** (`title`, `content`, `templateType`) חייבת לקבוע
      // בדיוק `הקודם + 1`. לקוח ישן מלפני C-1, שהיה דורס בשקט שינוי חדש
      // יותר, נדחה. כתיבות אחרות (הצמדה, סדר, דגלים, ארכוב, שיתוף) לא
      // מעלות את המונה וגם לא חייבות - אבל אם נגעו בו, אותו כלל של שלב 1.
      function contentChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'content', 'templateType']);
      }

      function revisionChecked() {
        return request.resource.data.get('revision', 0) == resource.data.get('revision', 0) + 1
          || (!contentChanged()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['revision', 'saveId']));
      }

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && !('createdVia' in request.resource.data)
        && request.resource.data.get('revision', 0) == 0
        && request.resource.data.get('updatedBy', null) == request.auth.uid;

      // שותף לא משנה `isSensitive` ולא `categoryId` (§12.2): העברה של פתק
      // מקטגוריה רגישה לקטגוריה שלו הייתה מבטלת את הרגישות בפועל, וגם
      // "מעלימה" את הפתק מהבעלים (SH-2).
      // `isReadOnly` (קריאה בלבד ל-Claude) - רק הבעלים, כמו `isSensitive`.
      allow update: if writerStamp()
        && revisionChecked()
        && createdViaUnchanged()
        && (isOwner(resource.data.userId)
          || (isSharedWithMe(resource.data) && ownershipUnchanged()
            && ownerOnlyFieldsUnchanged(['isSensitive', 'categoryId', 'isReadOnly']))
          || isLeavingShare());

      allow delete: if isOwner(resource.data.userId);

      // היסטוריית גרסאות. נכתבת אך ורק ע"י הטריגר בענן (Admin SDK), ולכן
      // אין כאן הרשאת כתיבה כלל. קריאה - לכל מי שיכול לקרוא את הפתק עצמו,
      // לפי המצב הנוכחי של הפתק: מי שהוסר מהשיתוף מאבד גם את ההיסטוריה.
      // פתק שנמחק - `get` נכשל והקריאה נדחית.
      match /versions/{versionId} {
        allow read: if canReadNote(get(/databases/$(database)/documents/notes/$(noteId)).data);
        allow write: if false;
      }

      // "הפתק פתוח" (סימון נוכחות): כל עורך פתוח כותב סימון משלו ומרענן
      // אותו. רואים - מי שיכול לקרוא את הפתק. כותבים ומוחקים - רק את
      // הסימון של עצמך. `refreshedAt` הוא זמן השרת (לא ניתן לזייף "פתוח
      // עד מחר"), ו-`expiresAt` מוגבל ל-5 דקות קדימה (לניקוי TTL בלבד).
      // שרת ה-MCP קורא את הסימונים לפני עריכה (Admin SDK).
      match /presence/{sessionId} {
        function validPresence() {
          let data = request.resource.data;
          return data.keys().hasOnly(['uid', 'device', 'refreshedAt', 'expiresAt'])
            && data.uid == request.auth.uid
            && data.device is string && data.device.size() <= 40
            && data.refreshedAt == request.time
            && data.expiresAt is timestamp
            && data.expiresAt <= request.time + duration.value(5, 'm');
        }

        allow read: if canReadNote(get(/databases/$(database)/documents/notes/$(noteId)).data);
        allow create: if canReadNote(get(/databases/$(database)/documents/notes/$(noteId)).data)
          && validPresence();
        allow update: if resource.data.uid == request.auth.uid
          && canReadNote(get(/databases/$(database)/documents/notes/$(noteId)).data)
          && validPresence();
        allow delete: if resource.data.uid == request.auth.uid;
      }
    }

    // תזכורות למשימות. נוצרות ומתוחזקות אך ורק ע"י טריגר בענן שרץ
    // דרך Admin SDK ועוקף את הכללים - ולכן אין כאן הרשאת כתיבה כלל.
    // קריאה מותרת לבעלים, כדי שהממשק יוכל להציג מה מתוזמן.
    match /reminders/{reminderId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // מסמך המשתמש המלא - כולל הגדרות אישיות. נגיש לבעליו בלבד.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // מזהי המכשירים לקבלת התראות push.
      // נדרש match מפורש: כללים ב-Firestore לא חלים על קולקציות משנה
      // אלא אם נעשה שימוש ב-`{document=**}`, ולכן ההרשאה שלמעלה
      // לא מכסה את הקולקציה הזו.
      //
      // הפונקציה המתוזמנת קוראת וכותבת כאן דרך Admin SDK, שעוקף
      // את הכללים - אין צורך להתיר לה גישה במפורש.
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // זיכרון המוצרים להשלמה אוטומטית ברשימת הקניות.
      // נכתב מהלקוח ברגע שמוצר נוסף לרשימה, ולכן נדרשת כאן הרשאת כתיבה
      // (בניגוד ל-`reminders`, שנכתבת רק מהשרת).
      match /products/{productId} {
        allow read, write: if isOwner(userId);
      }
    }

    // שם תצוגה ואימייל לפי מזהה משתמש - להצגת "משותף עם" בשמות.
    //
    // רק `get` (לפי מזהה ידוע), לעולם לא `list`: קודם כל משתמש מחובר יכול
    // היה לשלוף את כל הקולקציה, כלומר את האימיילים של כל המשתמשים.
    // חיפוש לפי אימייל לצורך שיתוף עבר ל-callable `findUserByEmail`,
    // שבודק מול Firebase Auth ומגביל קצב.
    //
    // כתיבה: רק לרשומה של עצמך, ורק עם האימייל שלך, ורק אם הוא מאומת.
    // קודם אפשר היה לרשום אימייל של מישהו אחר ולקבל את השיתופים שלו.
    // `lower()` כי האימייל נשמר מנורמל, וב-token הוא עשוי להכיל אותיות גדולות.
    match /userLookup/{userId} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create, update: if isOwner(userId)
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['email', 'displayName'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.displayName is string;

      allow delete: if isOwner(userId);
    }

    // מוני הגבלת קצב של `findUserByEmail` ושל נקודות ה-OAuth. Admin SDK בלבד.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // שרת ה-MCP: ה-Authorization Server (thinking/mcp-plan.md §2.3, §8.1)
    //
    // הכל נכתב רק ע"י Admin SDK. הכללים כאן מפורשים לתיעוד: `false` הוא
    // גם ברירת המחדל. tokens ו-codes נשמרים כ-hash בלבד, אבל גם ה-hash
    // לא נחשף ללקוח.
    // ---------------------------------------------------------------------

    match /oauthClients/{clientId} {
      allow read, write: if false;
    }

    match /oauthRequests/{reqId} {
      allow read, write: if false;
    }

    match /oauthCodes/{codeHash} {
      allow read, write: if false;
    }

    match /oauthTokens/{tokenHash} {
      allow read, write: if false;
    }

    // "אפליקציות מחוברות" בפרופיל (שלב 1ג): הבעלים רואה את החיבורים שלו.
    // ביטול רק דרך callable, לא בכתיבה ישירה.
    match /oauthGrants/{grantId} {
      allow read: if isOwner(resource.data.uid);
      allow write: if false;
    }

    // יומן הפעולות של Claude (mcp-plan §6). נכתב רק בשרת, באותו transaction
    // של הכתיבה עצמה. הבעלים רואה את מה ש-Claude עשה בשמו - "פעילות Claude"
    // בהגדרות. אין כתיבה מהאפליקציה, גם לא מחיקה.
    match /auditLog/{entryId} {
      allow read: if isOwner(resource.data.uid);
      allow write: if false;
    }

    // מניעת כפילויות ב-`create_note` (retry אחרי timeout). שרת בלבד.
    match /mcpIdempotency/{key} {
      allow read, write: if false;
    }

    // התנגשות שהגיעה לבחירה בעורך (`services/api/conflictEvents.ts`): אירוע
    // אנונימי, למדידה אם E1 נחוץ. **בלי** uid, מזהה פתק או תוכן - רק סיבה,
    // שמות שדות מתוך רשימה סגורה, סוג תבנית וגרסה. נוצר ע"י משתמש מחובר
    // (נגד הצפה מבחוץ), לא נקרא ולא משתנה מהלקוח; קוראים במסוף.
    match /conflictEvents/{eventId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['at', 'reason', 'fields', 'templateType', 'clientVersion'])
        && request.resource.data.keys().hasAll(['at', 'reason', 'fields', 'templateType', 'clientVersion'])
        && request.resource.data.at == request.time
        && request.resource.data.reason in ['title', 'text', 'unreadable', 'same-field', 'schedule', 'edit-vs-delete', 'both-added']
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 16
        && request.resource.data.fields.hasOnly(['text', 'completed', 'dueDate', 'dueTime', 'repeat', 'repeatBase',
             'priority', 'name', 'quantity', 'checked', 'header', 'content', 'description', 'amount', 'date', 'other'])
        && request.resource.data.templateType in ['plain', 'checklist', 'shopping', 'workplan', 'accounting', 'recipe', 'other']
        && request.resource.data.clientVersion is string
        && request.resource.data.clientVersion.size() <= 20;
      allow read, update, delete: if false;
    }

    // allowlist המשתמשים של שרת ה-MCP (`config/mcp`). נערך רק מה-console:
    // לקוח שיכול לקרוא אותו יודע מי מורשה, ולקוח שיכול לכתוב - מורשה.
    // `config/app` (D4a): `minClientVersion` - כל לקוח קורא אותו בפתיחה,
    // גם לפני התחברות, כדי לדעת אם הגרסה שלו עוד רשאית לכתוב. רק `get`:
    // אי אפשר לרשום את `config` (ו-`config/mcp` נשאר סגור). כתיבה - רק
    // מהמסוף של Firebase / Admin SDK.
    match /config/{configId} {
      allow get: if configId == 'app';
      allow list, write: if false;
    }
  }
}
