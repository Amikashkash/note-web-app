{
  "name": "notes-app-functions",
  "description": "פונקציות ענן לאפליקציית הפתקים - שליחת תזכורות",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:emulator": "vitest run -c vitest.emulator.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^7.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/express": "^5.0.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
